# PostgreSQL connection string
DATABASE_URL="postgresql://engfeed:engfeed123@localhost:5432/engfeed?schema=public"

# Redis connection string
REDIS_URL="redis://localhost:6379"

# Admin API Key for manual trigger & sync endpoints
ADMIN_API_KEY="engfeed_secret_admin_key_2026"

# Node Environment
NODE_ENV="development"

# Article classifier: any OpenAI-compatible API. Leave LLM_MODEL unset to skip it; the feed still works,
# with keyword tags and no filtering of announcements or marketing posts.
# Local Ollama (free): start it with OLLAMA_CONTEXT_LENGTH=4096 ollama serve
# Groq (free tier): LLM_BASE_URL="https://api.groq.com/openai/v1", plus LLM_API_KEY
# Gemini (free tier): LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai", plus LLM_API_KEY,
# LLM_MODEL="gemini-3.5-flash-lite", LLM_BATCH_SIZE="10" and LLM_MIN_INTERVAL_MS="6000"
# LLM_MODEL="qwen2.5:3b"
# LLM_BASE_URL="http://localhost:11434/v1"
# LLM_API_KEY=""
# LLM_BATCH_SIZE="1"
# LLM_MAX_PER_RUN="200"
# LLM_MIN_INTERVAL_MS="0"
