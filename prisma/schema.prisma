datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum FeedStatus {
  ACTIVE
  FAILING
  BROKEN
  RETIRED
}

enum ArticleKind {
  ENGINEERING
  ANNOUNCEMENT
  CAREERS
  MARKETING
}

model Company {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  logoUrl     String?
  rssUrl      String    @unique
  rssUrlPinned Boolean  @default(true)
  suggestedRssUrl String?
  websiteUrl  String
  category    String    // e.g. "Cloud & Infra", "Fintech", "AI & ML", "DevTools", "Big Tech", "Data Engineering"
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  feedStatus          FeedStatus @default(ACTIVE)
  consecutiveFailures Int        @default(0)
  lastError           String?    @db.Text
  lastFetchedAt       DateTime?
  lastSuccessAt       DateTime?
  etag                String?
  lastModified        String?

  articles    Article[]

  @@index([category])
  @@index([slug])
  @@index([feedStatus])
}

model Article {
  id          String    @id @default(cuid())
  companyId   String
  title       String
  slug        String
  url         String    @unique
  guidHash    String    @unique
  summary     String    @db.Text
  content     String    @db.Text
  publishedAt DateTime
  readTime    Int       @default(3) // in minutes
  tags        String[]  // Tech tags e.g. ["AI", "Architecture", "Distributed Systems"]
  viewsCount  Int       @default(0)
  kind        ArticleKind? // null until classified
  kindConfident Boolean?  // false when the model wasn't sure; only confident non-engineering posts are hidden
  classifiedAt DateTime?
  classifierVersion Int   @default(0) // below CLASSIFIER_VERSION means (re)classify
  classifyAttempts Int    @default(0)
  bodyText    String?   @db.Text // start of the article page's text, for classification only; never shown
  bodyFetchedAt DateTime?
  bodyFetchAttempts Int  @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bookmarks   UserBookmark[]
  reads       UserRead[]

  @@index([companyId])
  @@index([kind])
  @@index([publishedAt(sort: Desc)])
  @@index([slug])
}

model UserBookmark {
  id        String   @id @default(cuid())
  userId    String   @default("default-user")
  articleId String
  createdAt DateTime @default(now())

  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
}

model UserRead {
  id        String   @id @default(cuid())
  userId    String   @default("default-user")
  articleId String
  createdAt DateTime @default(now())

  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
}
