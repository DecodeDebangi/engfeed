datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  logoUrl     String?
  rssUrl      String    @unique
  websiteUrl  String
  category    String    // e.g. "Cloud & Infra", "Fintech", "AI & ML", "DevTools", "Big Tech", "Data Engineering"
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  articles    Article[]

  @@index([category])
  @@index([slug])
}

model Article {
  id          String    @id @default(cuid())
  companyId   String
  title       String
  slug        String
  url         String    @unique
  guidHash    String    @unique
  summary     String    @db.Text
  content     String    @db.Text
  publishedAt DateTime
  readTime    Int       @default(3) // in minutes
  tags        String[]  // Tech tags e.g. ["AI", "Architecture", "Distributed Systems"]
  viewsCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bookmarks   UserBookmark[]

  @@index([companyId])
  @@index([publishedAt(sort: Desc)])
  @@index([slug])
}

model UserBookmark {
  id        String   @id @default(cuid())
  userId    String   @default("default-user")
  articleId String
  createdAt DateTime @default(now())

  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
}
